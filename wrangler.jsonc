{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thread-lightly",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-20",

  // The Foldkit client is built by Vite into dist/client and served as static
  // assets. Only /api/* runs the Worker; everything else goes straight to the
  // asset server, which falls back to index.html for client-side routes.
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },

  "routes": [
    { "pattern": "threadlightly.jonstuebe.com", "custom_domain": true },
  ],

  "vars": {
    // The cheap model for in-character small talk (docs/design.md, tier 2).
    "SMALLTALK_MODEL": "@cf/meta/llama-3.1-8b-instruct-fast",
    // The composer: picks from a guest's dictionary replies and writes one
    // that answers the exact question (docs/design.md, tier 1). Bigger than the
    // small-talk model, since it has to keep every claim intact.
    "REPLY_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
  },

  // Clef routing and small talk. The AI binding always runs remotely, even in
  // local dev, so `bun run dev` needs a `wrangler login`.
  "ai": { "binding": "AI" },

  // One CaseObject per game (worker/case-object.ts).
  "durable_objects": {
    "bindings": [{ "name": "CASES", "class_name": "CaseObject" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CaseObject"] }],

  "observability": { "enabled": true },

  // PR Previews (`wrangler preview`) don't inherit bindings from the top level.
  // Each Preview gets its own isolated CaseObject namespace; migrations above
  // still apply.
  "previews": {
    "vars": {
      "SMALLTALK_MODEL": "@cf/meta/llama-3.1-8b-instruct-fast",
      "REPLY_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    },
    "ai": { "binding": "AI" },
    "durable_objects": {
      "bindings": [{ "name": "CASES", "class_name": "CaseObject" }],
    },
  },
}
